<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.eia</groupId>
    <artifactId>super-dwarf-mario-kart-deluxe-camel-edition</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- The display name is deliberate: underscores and hyphen included. See AppConfig.APP_NAME. -->
    <name>Super_Dwarf_Mario_Kart_Deluxe-Camel_Edition</name>
    <description>JavaFX music player with hand-written data structures and a beat-synced rhythm game</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Versions below were verified to resolve against Maven Central before use. -->
        <!-- Overridden on the command line: ./mvnw javafx:run -Dsdmk.smokeTest=true
             launches the app, prints what it verified, and closes itself. -->
        <sdmk.smokeTest>false</sdmk.smokeTest>

        <javafx.version>26.0.2</javafx.version>
        <mp3spi.version>1.9.5.4</mp3spi.version>
        <jackson.version>2.22.1</jackson.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- ==== JavaFX (presentation only; ds/model/playback/audio/analysis must not import it) ==== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- SwingFXUtils: converting decoded/analysed images between AWT and JavaFX. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ==== MP3 decoding through the javax.sound.sampled SPI ==== -->
        <!-- Transitively pulls jlayer + tritonus-share, which register the MPEG SPI providers. -->
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>mp3spi</artifactId>
            <version>${mp3spi.version}</version>
            <exclusions>
                <!-- jlayer declares JUnit 3.8.2 at compile scope, which would put an ancient
                     test framework on the main classpath. Tests use JUnit 5 only. -->
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ==== Persistence (library, scores, beatmap cache) ==== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ==== Tests ==== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.eia.superdwarfkart.app.App</mainClass>
                    <options>
                        <!-- Fixed heap so behaviour is identical across the team's machines
                             rather than derived from each one's physical RAM. -->
                        <option>-Xmx1g</option>
                        <!-- javafx:run forks a JVM, so -D on the Maven command line does not
                             reach the application unless it is forwarded here. -->
                        <option>-Dsdmk.smokeTest=${sdmk.smokeTest}</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
